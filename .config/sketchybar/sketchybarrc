CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
mkdir -p "$PLUGIN_DIR"

# -----------------------------------------------------------------------------
# Theme
# -----------------------------------------------------------------------------
# BAR_BG=0xff111318
BAR_BG=0x00000000
ISLAND_BG=0xe61e2028
ISLAND_BORDER=0x24ffffff
FG=0xffc7c7c7
FG_ACTIVE=0xffffffff
FG_DIM=0x80c7c7c7
WARNING=0xffd7995b
CRITICAL=0xffa55555
TRANSPARENT=0x00000000

FONT="JetBrainsMono Nerd Font"
FONT_REGULAR="$FONT:Regular:12.0"
FONT_MEDIUM="$FONT:Medium:12.0"
FONT_LARGE="$FONT:Medium:14.0"

chmod +x "$PLUGIN_DIR"/*.sh

# -----------------------------------------------------------------------------
# Bar and defaults
# -----------------------------------------------------------------------------
sketchybar --bar \
  position=top \
  height=32 \
  color="$BAR_BG" \
  border_width=0 \
  corner_radius=0 \
  margin=0 \
  y_offset=1 \
  blur_radius=0 \
  padding_left=8 \
  padding_right=8 \
  item_spacing=10 \
  shadow=off \
  sticky=on \
  topmost=window \
  font_smoothing=on

sketchybar --default \
  icon.font="$FONT_REGULAR" \
  icon.color="$FG" \
  icon.padding_left=0 \
  icon.padding_right=0 \
  label.font="$FONT_REGULAR" \
  label.color="$FG" \
  label.padding_left=0 \
  label.padding_right=0 \
  label.drawing=off \
  background.drawing=off \
  padding_left=0 \
  padding_right=0

# -----------------------------------------------------------------------------
# Left: Apple + AeroSpace workspaces
# -----------------------------------------------------------------------------
sketchybar --add item workspaces left \
  --set workspaces \
    icon="" \
    icon.font="$FONT_LARGE" \
    icon.padding_left=10 \
    icon.padding_right=4 \
	y_offset=1 \
    click_script='open -a "System Settings"' \
    label.drawing=off

sketchybar --add event aerospace_workspace_change

workspaces=""
workspace_items=""
if command -v aerospace >/dev/null 2>&1; then
  workspaces="$(aerospace list-workspaces --all 2>/dev/null)"
fi
[ -z "$workspaces" ] && workspaces="1
2
3
4
5"

while IFS= read -r sid; do
  [ -z "$sid" ] && continue
  safe_sid="$(printf '%s' "$sid" | tr -c '[:alnum:]_-' '_')"
  item="space.$safe_sid"
  workspace_items="$workspace_items $item"

  sketchybar --add item "$item" left \
    --set "$item" \
      label="$sid" \
      label.drawing=on \
      label.font="$FONT_REGULAR" \
      label.color="$FG_DIM" \
      label.padding_left=6 \
      label.padding_right=6 \
      padding_left=1 \
      padding_right=1 \
      click_script="aerospace workspace '$sid'" \
      script="$PLUGIN_DIR/aerospace.sh '$sid'" \
      update_freq=10 \
    --subscribe "$item" aerospace_workspace_change front_app_switched

done <<EOF
$workspaces
EOF

sketchybar --add bracket left_island workspaces $workspace_items \
  --set left_island \
    background.drawing=on \
    background.color="$ISLAND_BG" \
    background.border_color="$ISLAND_BORDER" \
    background.border_width=1 \
    background.corner_radius=10 \
    background.height=26 \
    background.padding_left=4 \
    background.padding_right=4

# -----------------------------------------------------------------------------
# Right: Time
# -----------------------------------------------------------------------------
sketchybar --add item clock right \
  --set clock \
    label.drawing=on \
    label.font="$FONT_REGULAR" \
    label.padding_left=6 \
    label.padding_right=6 \
    padding_left=1 \
    padding_right=1 \
    script="$PLUGIN_DIR/clock.sh" \
    update_freq=10 \
    click_script='open -a Calendar'

sketchybar --add item right_island_gap right \
  --set right_island_gap \
    drawing=on \
    width=8

# -----------------------------------------------------------------------------
# Right: Bluetooth, network, audio, CPU, battery
# -----------------------------------------------------------------------------
sketchybar --add item bluetooth right \
  --set bluetooth \
    icon="" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    padding_left=1 \
    padding_right=1 \
    script="$PLUGIN_DIR/bluetooth.sh" \
    update_freq=30 \
  --subscribe bluetooth mouse.clicked system_woke

sketchybar --add item network right \
  --set network \
    icon="󰤨" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    padding_left=1 \
    padding_right=1 \
    script="$PLUGIN_DIR/wifi.sh" \
    update_freq=10 \
  --subscribe network mouse.clicked wifi_change system_woke

sketchybar --add item volume right \
  --set volume \
    icon="" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    padding_left=1 \
    padding_right=1 \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change mouse.clicked mouse.scrolled system_woke

sketchybar --add item cpu right \
  --set cpu \
    icon="󰍛" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    padding_left=1 \
    padding_right=1 \
    click_script='open -a "Activity Monitor"'

sketchybar --add item battery right \
  --set battery \
    icon="󰁹" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    padding_left=1 \
    padding_right=1 \
    label.drawing=on \
    label.padding_left=5 \
    script="$PLUGIN_DIR/battery.sh" \
    update_freq=30 \
  --subscribe battery power_source_change mouse.clicked system_woke

sketchybar --add bracket time_island clock \
  --set time_island \
    background.drawing=on \
    background.color="$ISLAND_BG" \
    background.border_color="$ISLAND_BORDER" \
    background.border_width=1 \
    background.corner_radius=10 \
    background.height=26 \
    background.padding_left=5 \
    background.padding_right=5

sketchybar --add bracket status_island bluetooth network volume cpu battery \
  --set status_island \
    background.drawing=on \
    background.color="$ISLAND_BG" \
    background.border_color="$ISLAND_BORDER" \
    background.border_width=1 \
    background.corner_radius=10 \
    background.height=26 \
    background.padding_left=4 \
    background.padding_right=4

# Initialize every scripted item and select the current AeroSpace workspace.
sketchybar --update

if command -v aerospace >/dev/null 2>&1; then
  focused="$(aerospace list-workspaces --focused 2>/dev/null | head -n 1)"
  [ -n "$focused" ] && sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$focused"
fi
