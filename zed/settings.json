{
	"vim_mode": true,
	"vim": {
		"toggle_relative_line_numbers": true,
	},
	"relative_line_numbers": "enabled",
	"tab_size": 4,
	"hard_tabs": true,
	"use_smartcase_search": true,
	"autosave": {
		"after_delay": {
			"milliseconds": 1000,
		},
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"ui_font_size": 16,
	"buffer_font_size": 15,
	"theme": {
		"mode": "system",
		"light": "One Light",
		"dark": "One Dark",
	},
}
