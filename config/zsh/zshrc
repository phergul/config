# Standalone macOS shell configuration. Home Manager consumes common.zsh directly.

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

path=(
  "$HOME/bin"
  "$HOME/go/bin"
  $path
)

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
plugins=(git sudo)

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

HISTSIZE=10000
SAVEHIST=10000
HISTFILE="$HOME/.zsh_history"
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
unsetopt APPEND_HISTORY EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST
unsetopt HIST_FIND_NO_DUPS HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS

if command -v brew >/dev/null 2>&1; then
  autosuggestions="$(brew --prefix zsh-autosuggestions 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -r "$autosuggestions" ] && source "$autosuggestions"
  unset autosuggestions
fi

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

[[ -r "$HOME/.config/zsh/common.zsh" ]] && source "$HOME/.config/zsh/common.zsh"

if command -v brew >/dev/null 2>&1; then
  syntax_highlighting="$(brew --prefix zsh-syntax-highlighting 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  [ -r "$syntax_highlighting" ] && source "$syntax_highlighting"
  unset syntax_highlighting
fi
