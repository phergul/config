layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                format_left   "{mode}#[bg=#232136] {tabs}"
                format_center ""
                format_right  "#[bg=#EA9A97,fg=#232136,bold]  #[bg=#393552,fg=#EA9A97,bold] {session} #[bg=#232136] #[bg=#393552,fg=#9CCFD8,bold] {datetime}  "
                format_space  ""

                format_hide_on_overlength "true"
                format_precedence "crl"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#393552]{char}"
                border_position "top"

                mode_normal        "#[bg=#9CCFD8,fg=#232136,bold] NORMAL#[bg=#232136,fg=#9CCFD8]█"
                mode_locked        "#[bg=#393552,fg=#232136,bold] LOCKED #[bg=#232136,fg=#393552]█"
                mode_resize        "#[bg=#EB6F92,fg=#232136,bold] RESIZE#[bg=#232136,fg=#EB6F92]█"
                mode_pane          "#[bg=#3E8FB0,fg=#232136,bold] PANE#[bg=#232136,fg=#3E8FB0]█"
                mode_tab           "#[bg=#C4A7E7,fg=#232136,bold] TAB#[bg=#232136,fg=#C4A7E7]█"
                mode_scroll        "#[bg=#F6C177,fg=#232136,bold] SCROLL#[bg=#232136,fg=#F6C177]█"
                mode_enter_search  "#[bg=#3E8FB0,fg=#232136,bold] ENT-SEARCH#[bg=#232136,fg=#3E8FB0]█"
                mode_search        "#[bg=#3E8FB0,fg=#232136,bold] SEARCHARCH#[bg=#232136,fg=#3E8FB0]█"
                mode_rename_tab    "#[bg=#C4A7E7,fg=#232136,bold] RENAME-TAB#[bg=#232136,fg=#C4A7E7]█"
                mode_rename_pane   "#[bg=#3E8FB0,fg=#232136,bold] RENAME-PANE#[bg=#232136,fg=#3E8FB0]█"
                mode_session       "#[bg=#9CCFD8,fg=#232136,bold] SESSION#[bg=#232136,fg=#9CCFD8]█"
                mode_move          "#[bg=#EA9A97,fg=#232136,bold] MOVE#[bg=#232136,fg=#EA9A97]█"
                mode_prompt        "#[bg=#3E8FB0,fg=#232136,bold] PROMPT#[bg=#232136,fg=#3E8FB0]█"
                mode_tmux          "#[bg=#F6C177,fg=#232136,bold] TMUX#[bg=#232136,fg=#F6C177]█"

                tab_normal              "#[bg=#232136,fg=#3E8FB0]█#[bg=#3E8FB0,fg=#232136,bold]{index} #[bg=#393552,fg=#3E8FB0,bold] {name}{floating_indicator}#[bg=#232136,fg=#393552,bold]█"
                tab_normal_fullscreen   "#[bg=#232136,fg=#3E8FB0]█#[bg=#3E8FB0,fg=#232136,bold]{index} #[bg=#393552,fg=#3E8FB0,bold] {name}{fullscreen_indicator}#[bg=#232136,fg=#393552,bold]█"
                tab_normal_sync         "#[bg=#232136,fg=#3E8FB0]█#[bg=#3E8FB0,fg=#232136,bold]{index} #[bg=#393552,fg=#3E8FB0,bold] {name}{sync_indicator}#[bg=#232136,fg=#393552,bold]█"

                tab_active              "#[bg=#232136,fg=#F6C177]█#[bg=#F6C177,fg=#232136,bold]{index} #[bg=#393552,fg=#F6C177,bold] {name}{floating_indicator}#[bg=#232136,fg=#393552,bold]█"
                tab_active_fullscreen   "#[bg=#232136,fg=#F6C177]█#[bg=#F6C177,fg=#232136,bold]{index} #[bg=#393552,fg=#F6C177,bold] {name}{fullscreen_indicator}#[bg=#232136,fg=#393552,bold]█"
                tab_active_sync         "#[bg=#232136,fg=#F6C177]█#[bg=#F6C177,fg=#232136,bold]{index} #[bg=#393552,fg=#F6C177,bold] {name}{sync_indicator}#[bg=#232136,fg=#393552,bold]█"

                tab_separator           "#[bg=#232136] "

                tab_sync_indicator       " "
                tab_fullscreen_indicator " 󰊓"
                tab_floating_indicator   " 󰹙"

                datetime        "{format}"
                datetime_format "%A, %d %b %Y %H:%M"
                datetime_timezone "Europe/London"
            }
        }
        children
    }
}
